# Copia este archivo como ".env". El archivo .env nunca se sube al repositorio.

# Administrador inicial (Dirección de Protección Animal). Se crea solo si aún no existe ningún administrador.
ADMIN_EMAIL=proteccionanimal@tu-dominio.gov.co
# Mínimo 12 caracteres
ADMIN_PASSWORD=

# true = carga mascotas y hogares de ejemplo en una base vacía (solo para pruebas)
SEED_DEMO=true

# true cuando el sitio ya se sirve por HTTPS (obligatorio en producción)
COOKIE_SECURE=false

# 1 cuando hay un proxy inverso o Ingress delante del contenedor (para registrar la IP real)
TRUST_PROXY=0

# Puerto en el que queda publicada la aplicación
PUERTO_WEB=8080

# Opcional: secreto de sesión (mínimo 32 caracteres). Si lo dejas vacío se genera solo y se guarda en el volumen.
JWT_SECRET=
