# ════════════════════════════════════════════════════════════════════════════
#  PATAS · archivo de configuración
#  1. Copia este archivo como «.env»  (cp .env.example .env)
#  2. Completa los valores. El archivo .env NUNCA se sube a un repositorio.
#  3. Si un valor contiene el símbolo $, enciérralo entre comillas simples: 'mi$clave'
#  Guía completa: DESPLIEGUE.md
# ════════════════════════════════════════════════════════════════════════════

# ── Publicación ─────────────────────────────────────────────────────────────
# Dirección pública del sitio, con https y sin barra final. Se usa en los enlaces de los correos.
APP_URL=https://patas.ejemplo.gov.co
# Puerto del equipo donde queda publicada la aplicación
PUERTO_WEB=8080
# true cuando el sitio se sirve por HTTPS (obligatorio en producción)
COOKIE_SECURE=true
# 1 si hay un proxy inverso, balanceador o Ingress delante del contenedor; 0 si no
TRUST_PROXY=1

# ── Base de datos (obligatorio) ─────────────────────────────────────────────
# Contraseña de PostgreSQL. Genera una con:  openssl rand -base64 32
DB_PASSWORD=

# ── Sesiones (opcional) ─────────────────────────────────────────────────────
# Secreto para firmar las sesiones (mínimo 32 caracteres). Si lo dejas vacío,
# se genera uno automáticamente y se guarda en el volumen. Generar:  openssl rand -hex 32
JWT_SECRET=

# ── Administrador inicial (control total) ───────────────────────────────────
# Se crea en el primer arranque, solo si todavía no existe ningún administrador.
ADMIN_EMAIL=
ADMIN_NOMBRE=Dirección de Protección Animal
# Recomendado: hash de la contraseña (no la contraseña). Ver DESPLIEGUE.md, paso 3.
ADMIN_PASSWORD_HASH=
# Alternativa: contraseña en texto (mínimo 12 caracteres). Bórrala del .env después del primer arranque.
ADMIN_PASSWORD=

# ── Google reCAPTCHA v3 de la entidad ───────────────────────────────────────
# Crear en https://www.google.com/recaptcha/admin  (tipo «Basado en puntuaciones (v3)»)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Puntaje mínimo para aceptar un envío (0.0 a 1.0)
RECAPTCHA_MIN_SCORE=0.5

# ── Correo electrónico (recuperación de contraseña y notificaciones) ────────
SMTP_HOST=
# 587 con STARTTLS (SMTP_SECURE=false) o 465 con SSL (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que verán los ciudadanos
SMTP_FROM=PATAS Mosquera <no-responder@ejemplo.gov.co>
# Correos de la entidad que reciben avisos de solicitudes, hogares y donaciones (separados por coma)
NOTIFICACIONES_CORREO=

# ── Datos de la entidad (pie de página y política de privacidad) ────────────
ENTIDAD_NOMBRE=Alcaldía Municipal de Mosquera
ENTIDAD_DEPENDENCIA=Secretaría de Ambiente – Dirección de Protección Animal
ENTIDAD_DIRECCION=
ENTIDAD_CORREO=
ENTIDAD_TELEFONO=
ENTIDAD_HORARIO=
# WhatsApp de la línea de bienestar animal: 57 + número, solo dígitos. Vacío = no se muestra el botón
WHATSAPP_BIENESTAR=

# ── Mapas (opcional) ────────────────────────────────────────────────────────
# Por defecto: Leaflet + OpenStreetMap, gratuito y sin clave. Solo cambia esto si la entidad
# tiene su propio servidor de mapas o un proveedor con licencia.
MAPA_TILES_URL=
MAPA_ATRIBUCION=
# Capa satelital opcional (se muestra un botón «Satélite» solo si se define)
MAPA_SATELITE_URL=
MAPA_SATELITE_ATRIBUCION=
